{
  "name": "@modusoperandi/licit-glossary",
  "version": "2.0.3",
  "license": "MIT",
  "type": "module",
  "description": "MO's Glossary ProseMirror Plugin",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-plugin-contrib-glossary"
  },
  "peerDependencies": {
   "@modusoperandi/licit-doc-attrs-step": "file:modusoperandi-licit-doc-attrs-step-1.0.3.tgz",
    "@modusoperandi/licit-ui-commands": "file:modusoperandi-licit-ui-commands-1.0.9.tgz",
    "prosemirror-model": "^1.0.0",
    "prosemirror-state": "^1.0.0",
    "prosemirror-transform": "^1.0.0",
    "prosemirror-view": "^1.0.0",
    "react": "^18.0.0"
  },
  "dependencies": {
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.1",
    "@types/jest": "^29.0.2",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/orderedmap": "^2.0.0",
    "@modusoperandi/eslint-config": "^2.1.4",
    "copyfiles": "^2.4.1",
    "eslint": "^9.37.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.1.2",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.1",
    "jest-sonar-reporter": "^2.0.0",
    "prosemirror-test-builder": "^1.1.1",
    "lint-staged": "^16.2.3",
    "prettier": "^3.2.5",
    "ts-jest": "^29.0.7",
    "ts-node": "^10.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "libxmljs2": "^1.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist/ && rm -f modusoperandi-licit-glossary-*.*.*.tgz",
    "lint": "npm run lint:css & npm run lint:ts",
    "lint:ts": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "jest",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "ci:build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist  && copyfiles package.json LICENSE dist",
    "ci:bom": "cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  }
}
